{% assign gh_repo = site.data.github.repos[include.repository] %}
{% assign repo_short = include.repository | split: '/' | last %}
<div class="repo p-2">
  <div class="card h-100">
    <div class="card-body d-flex flex-column">
      <h5 class="card-title mb-1">
        <a href="{{ gh_repo.url }}" target="_blank" rel="noopener">
          <i class="fa-brands fa-github me-1"></i>{{ repo_short }}
        </a>
      </h5>
      {% if gh_repo.description %}
        <p class="card-text text-muted flex-grow-1">{{ gh_repo.description }}</p>
      {% endif %}
      <div class="mt-2 d-flex justify-content-between align-items-center">
        {% if gh_repo.language %}
          <span class="badge rounded-pill text-bg-light border">{{ gh_repo.language }}</span>
        {% else %}
          <span></span>
        {% endif %}
        <span class="text-muted small">
          <span class="me-2"><i class="fa-solid fa-star"></i> {{ gh_repo.stars }}</span>
          <span><i class="fa-solid fa-code-fork"></i> {{ gh_repo.forks }}</span>
        </span>
      </div>
    </div>
  </div>
</div>
